# Configurazione del frontend — copia in .env e compila i valori.
# Non committare MAI il file .env reale.

# URL base delle API del backend (con /api finale, senza slash finale)
VITE_API_URL=http://localhost:7007/api

# --- Immagini dei servizi (Cloudinary, facoltativo) ---
# Permette all'admin di caricare una foto per ogni servizio. Gratis su
# cloudinary.com: dal dashboard copia il "Cloud name" e crea un upload preset
# UNSIGNED (Settings → Upload → Upload presets → Add preset → Signing Mode:
# Unsigned). Senza questi valori l'upload è disattivato (immagine di default).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Login con Google (facoltativo) ---
# Stesso Client ID configurato nel backend: abilita il bottone "Accedi con Google"
# su Login e Register. Senza questo valore il bottone non viene mostrato.
VITE_GOOGLE_CLIENT_ID=
