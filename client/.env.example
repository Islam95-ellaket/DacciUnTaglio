# Configurazione del frontend — copia in .env e compila i valori.
# Non committare MAI il file .env reale.

# URL base delle API del backend (con /api finale, senza slash finale)
VITE_API_URL=http://localhost:7007/api

# --- Login con Google (facoltativo) ---
# Stesso Client ID configurato nel backend: abilita il bottone "Accedi con Google"
# su Login e Register. Senza questo valore il bottone non viene mostrato.
VITE_GOOGLE_CLIENT_ID=
