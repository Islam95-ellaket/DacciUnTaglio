# Configurazione del backend — copia in .env e compila i valori.
# Non committare MAI il file .env reale.

# Database MongoDB (Atlas o locale)
MONGODB_URI=mongodb+srv://UTENTE:PASSWORD@cluster0.xxxxx.mongodb.net/NOME_DATABASE

# Segreto per firmare i JWT (stringa lunga e casuale)
JWT_SECRET=una-stringa-lunga-casuale

# Porta del server
PORT=7007

# URL del frontend (CORS): origine esatta, senza slash finale
FRONTEND_URL=http://localhost:5173

# --- Email di conferma (facoltative) ---
# Opzione 1 (consigliata in produzione): SendGrid via API HTTP — funziona anche
# su Render, che blocca l'SMTP in uscita. Crea una API key su sendgrid.com
# (Settings → API Keys) e verifica un mittente (Sender Authentication → Single
# Sender Verification). EMAIL_FROM deve essere la email verificata.
SENDGRID_API_KEY=

# Opzione 2 (sviluppo locale): SMTP. Senza SMTP_HOST l'email viene stampata in
# console (modalità sviluppo).
# Mailtrap (test): credenziali dalla scheda SMTP della tua inbox.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 + "password per le app".
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mittente mostrato nei client di posta: con SendGrid deve essere la email
# verificata; con Gmail il tuo indirizzo.
EMAIL_FROM=DacciUnTaglio <noreply@dacciuntaglio.it>

# --- Login con Google (facoltativo) ---
# Client ID dalla Google Cloud Console (Credenziali → Crea ID client OAuth → "Applicazione web").
# Origine JavaScript autorizzata: http://localhost:5173 (più l'URL di produzione al deploy).
# Finché la "schermata consenso OAuth" è in modalità testing, aggiungiti come utente di test.
# Senza questo valore l'endpoint /api/auth/google risponde 500.
GOOGLE_CLIENT_ID=

# --- Seed admin (usate solo da seed.js) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dacciuntaglio.it
ADMIN_PASSWORD=cambia-subito-questa-password
